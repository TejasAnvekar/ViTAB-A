#!/usr/bin/env python3
"""Self-contained evaluation for VisualCite vLLM prediction JSONL files."""

import argparse
import json
import math
import re
from pathlib import Path
from typing import Any, Dict, List, Optional, Sequence, Set, Tuple


CELL_RE = re.compile(r"^([A-Z]+)([0-9]+)$")


def _normalize_cells(value: Any, field: str, line_number: int) -> List[str]:
    if not isinstance(value, list):
        raise ValueError(f"Line {line_number}: {field} must be a list")

    normalized: List[str] = []
    for cell in value:
        if not isinstance(cell, str):
            raise ValueError(f"Line {line_number}: every item in {field} must be a string")
        canonical = cell.strip().lstrip("=").strip().upper()
        if canonical:
            normalized.append(canonical)
    return normalized


def _validate_row(row: Any, line_number: int) -> Dict[str, Any]:
    if not isinstance(row, dict):
        raise ValueError(f"Line {line_number}: each JSONL record must be an object")

    required = ("sample_id", "predicted_cells", "ground_truth_cells")
    missing = [field for field in required if field not in row]
    if missing:
        raise ValueError(f"Line {line_number}: missing required field(s): {', '.join(missing)}")
    if not isinstance(row["sample_id"], str) or not row["sample_id"].strip():
        raise ValueError(f"Line {line_number}: sample_id must be a non-empty string")

    validated = dict(row)
    validated["sample_id"] = row["sample_id"].strip()
    validated["predicted_cells"] = _normalize_cells(
        row["predicted_cells"], "predicted_cells", line_number
    )
    validated["ground_truth_cells"] = _normalize_cells(
        row["ground_truth_cells"], "ground_truth_cells", line_number
    )
    invalid_truth = [
        cell for cell in validated["ground_truth_cells"] if not CELL_RE.fullmatch(cell)
    ]
    if invalid_truth:
        raise ValueError(
            f"Line {line_number}: invalid ground-truth cell coordinate(s): "
            f"{', '.join(invalid_truth)}"
        )
    if not validated["ground_truth_cells"]:
        raise ValueError(f"Line {line_number}: ground_truth_cells must not be empty")
    return validated


def _prefer_record(current: Dict[str, Any], candidate: Dict[str, Any]) -> Dict[str, Any]:
    """Prefer a successful retry; otherwise retain the latest record."""
    current_failed = bool(current.get("error"))
    candidate_failed = bool(candidate.get("error"))
    if current_failed != candidate_failed:
        return current if not current_failed else candidate
    return candidate


def _load_rows(path: Path) -> Tuple[List[Dict[str, Any]], int, int]:
    records_by_id: Dict[str, Dict[str, Any]] = {}
    raw_records = 0
    with path.open("r", encoding="utf-8") as handle:
        for line_number, line in enumerate(handle, start=1):
            if not line.strip():
                continue
            raw_records += 1
            try:
                decoded = json.loads(line)
            except json.JSONDecodeError as exc:
                raise ValueError(f"Line {line_number}: invalid JSON: {exc.msg}") from exc
            row = _validate_row(decoded, line_number)
            sample_id = row["sample_id"]
            if sample_id in records_by_id:
                records_by_id[sample_id] = _prefer_record(records_by_id[sample_id], row)
            else:
                records_by_id[sample_id] = row

    rows = list(records_by_id.values())
    return rows, raw_records, raw_records - len(rows)


def _prf(predicted: Set[Any], truth: Set[Any]) -> Tuple[float, float, float]:
    if not predicted and not truth:
        return 1.0, 1.0, 1.0
    if not predicted or not truth:
        return 0.0, 0.0, 0.0
    true_positives = len(predicted & truth)
    precision = true_positives / len(predicted)
    recall = true_positives / len(truth)
    f1 = 2.0 * precision * recall / (precision + recall) if true_positives else 0.0
    return precision, recall, f1


def _row_col_sets(cells: Set[str]) -> Tuple[Set[int], Set[str]]:
    rows: Set[int] = set()
    columns: Set[str] = set()
    for cell in cells:
        match = CELL_RE.fullmatch(cell)
        if match:
            columns.add(match.group(1))
            rows.add(int(match.group(2)))
    return rows, columns


def _evaluate_sample(row: Dict[str, Any]) -> Dict[str, Any]:
    predicted = set(row["predicted_cells"])
    truth = set(row["ground_truth_cells"])
    pred_rows, pred_columns = _row_col_sets(predicted)
    truth_rows, truth_columns = _row_col_sets(truth)
    cell_precision, cell_recall, cell_f1 = _prf(predicted, truth)
    row_precision, row_recall, row_f1 = _prf(pred_rows, truth_rows)
    col_precision, col_recall, col_f1 = _prf(pred_columns, truth_columns)
    return {
        "sample_id": row["sample_id"],
        "predicted_cells": row["predicted_cells"],
        "ground_truth_cells": row["ground_truth_cells"],
        "cell_precision": cell_precision,
        "cell_recall": cell_recall,
        "cell_f1": cell_f1,
        "row_precision": row_precision,
        "row_recall": row_recall,
        "row_f1": row_f1,
        "column_precision": col_precision,
        "column_recall": col_recall,
        "column_f1": col_f1,
        "exact_match": predicted == truth,
        "partial_match": bool(predicted & truth),
    }


def _mean(values: Sequence[float]) -> float:
    return sum(values) / len(values) if values else 0.0


def _aggregate(samples: Sequence[Dict[str, Any]]) -> Dict[str, Any]:
    count = len(samples)
    exact = sum(bool(sample["exact_match"]) for sample in samples)
    partial = sum(bool(sample["partial_match"]) for sample in samples)
    total_predicted = sum(len(set(sample["predicted_cells"])) for sample in samples)
    total_truth = sum(len(set(sample["ground_truth_cells"])) for sample in samples)
    total_tp = sum(
        len(set(sample["predicted_cells"]) & set(sample["ground_truth_cells"]))
        for sample in samples
    )
    micro_precision = total_tp / total_predicted if total_predicted else 0.0
    micro_recall = total_tp / total_truth if total_truth else 0.0
    micro_f1 = (
        2.0 * micro_precision * micro_recall / (micro_precision + micro_recall)
        if micro_precision + micro_recall
        else 0.0
    )

    def macro(prefix: str) -> Dict[str, float]:
        return {
            "precision": _mean([float(sample[f"{prefix}_precision"]) for sample in samples]),
            "recall": _mean([float(sample[f"{prefix}_recall"]) for sample in samples]),
            "f1": _mean([float(sample[f"{prefix}_f1"]) for sample in samples]),
        }

    cell = macro("cell")
    cell.update(
        {
            "micro_precision": micro_precision,
            "micro_recall": micro_recall,
            "micro_f1": micro_f1,
        }
    )
    return {
        "total_samples": count,
        "cell_level": cell,
        "row_level": macro("row"),
        "column_level": macro("column"),
        "exact_match_rate": exact / count if count else 0.0,
        "exact_match_count": exact,
        "partial_match_rate": partial / count if count else 0.0,
        "partial_match_count": partial,
        "avg_predicted_cells": total_predicted / count if count else 0.0,
        "avg_ground_truth_cells": total_truth / count if count else 0.0,
    }


def _finite_float(value: Any) -> Optional[float]:
    if value is None or isinstance(value, bool):
        return None
    try:
        result = float(value)
    except (TypeError, ValueError):
        return None
    return result if math.isfinite(result) else None


def _auroc(confidences: Sequence[float], labels: Sequence[int]) -> Optional[float]:
    positives = sum(labels)
    negatives = len(labels) - positives
    if not positives or not negatives:
        return None

    order = sorted(range(len(confidences)), key=lambda index: confidences[index])
    rank_sum = 0.0
    start = 0
    while start < len(order):
        end = start + 1
        while end < len(order) and confidences[order[end]] == confidences[order[start]]:
            end += 1
        average_rank = ((start + 1) + end) / 2.0
        rank_sum += average_rank * sum(labels[index] for index in order[start:end])
        start = end
    return (rank_sum - positives * (positives + 1) / 2.0) / (positives * negatives)


def _calibration(
    confidences: Sequence[float], labels: Sequence[int], bins: int
) -> Tuple[float, float, List[Dict[str, Any]], float]:
    brier = _mean([(confidence - label) ** 2 for confidence, label in zip(confidences, labels)])
    epsilon = 1e-15
    nll = _mean(
        [
            -(label * math.log(min(max(confidence, epsilon), 1.0 - epsilon))
              + (1 - label) * math.log(min(max(1.0 - confidence, epsilon), 1.0 - epsilon)))
            for confidence, label in zip(confidences, labels)
        ]
    )
    details: List[Dict[str, Any]] = []
    ece = 0.0
    for index in range(bins):
        lower = index / bins
        upper = (index + 1) / bins
        members = [
            position
            for position, confidence in enumerate(confidences)
            if confidence >= lower and (confidence < upper or (index == bins - 1 and confidence <= upper))
        ]
        if not members:
            continue
        average_confidence = _mean([confidences[position] for position in members])
        accuracy = _mean([float(labels[position]) for position in members])
        gap = abs(accuracy - average_confidence)
        ece += len(members) / len(confidences) * gap
        details.append(
            {
                "lower": lower,
                "upper": upper,
                "count": len(members),
                "avg_confidence": average_confidence,
                "accuracy": accuracy,
                "absolute_gap": gap,
            }
        )
    return brier, nll, details, ece


def _selective_risk(confidences: Sequence[float], labels: Sequence[int]) -> Dict[str, Any]:
    ranked = sorted(zip(confidences, labels), key=lambda pair: pair[0], reverse=True)
    risks: List[float] = []
    errors = 0
    for index, (_, label) in enumerate(ranked, start=1):
        errors += 1 - label
        risks.append(errors / index)
    accuracies = [1.0 - risk for risk in risks]
    aurc = _mean(risks)
    auarc = _mean(accuracies)

    oracle_labels = sorted(labels, reverse=True)
    oracle_errors = 0
    oracle_risks: List[float] = []
    for index, label in enumerate(oracle_labels, start=1):
        oracle_errors += 1 - label
        oracle_risks.append(oracle_errors / index)
    oracle_aurc = _mean(oracle_risks)
    oracle_auarc = 1.0 - oracle_aurc

    operating_points: Dict[str, Dict[str, float]] = {}
    for coverage in (0.25, 0.5, 0.75, 0.9, 1.0):
        retained = max(1, math.ceil(len(ranked) * coverage))
        operating_points[f"{coverage:.2f}"] = {
            "retained": retained,
            "accuracy": _mean([float(label) for _, label in ranked[:retained]]),
            "risk": risks[retained - 1],
            "confidence_threshold": ranked[retained - 1][0],
        }
    return {
        "baseline_accuracy": accuracies[-1] if accuracies else 0.0,
        "auarc": auarc,
        "utility_premium": auarc - (accuracies[-1] if accuracies else 0.0),
        "oracle_auarc": oracle_auarc,
        "max_rejection": (len(ranked) - 1) / len(ranked) if ranked else 0.0,
        "aurc": aurc,
        "oracle_aurc": oracle_aurc,
        "excess_aurc": aurc - oracle_aurc,
        "metric_direction": {"auarc": "higher_is_better", "aurc": "lower_is_better"},
        "coverage_points": operating_points,
    }


def _uq_for_target(
    confidences: Sequence[float], labels: Sequence[int], bins: int
) -> Dict[str, Any]:
    brier, nll, bin_details, ece = _calibration(confidences, labels, bins)
    correct_confidences = [c for c, label in zip(confidences, labels) if label]
    incorrect_confidences = [c for c, label in zip(confidences, labels) if not label]
    return {
        "base_accuracy": _mean([float(label) for label in labels]),
        "accuracy": _mean([float(label) for label in labels]),
        "mean_confidence": _mean(confidences),
        "mean_confidence_when_correct": _mean(correct_confidences) if correct_confidences else None,
        "mean_confidence_when_incorrect": _mean(incorrect_confidences) if incorrect_confidences else None,
        "brier_score": brier,
        "binary_nll": nll,
        "ece": ece,
        "ece_bins": bin_details,
        "auroc": _auroc(confidences, labels),
        "selective_prediction": _selective_risk(confidences, labels),
    }


def _evaluate_uq(
    rows: Sequence[Dict[str, Any]], samples: Sequence[Dict[str, Any]], bins: int
) -> Dict[str, Any]:
    confidences: List[float] = []
    exact_labels: List[int] = []
    partial_labels: List[int] = []
    mean_logprobs: List[float] = []
    for row, sample in zip(rows, samples):
        mean_logprob = _finite_float(row.get("mean_token_logprob"))
        if row.get("error") or mean_logprob is None:
            continue
        confidence = min(1.0, math.exp(mean_logprob))
        confidences.append(confidence)
        mean_logprobs.append(mean_logprob)
        exact_labels.append(int(sample["exact_match"]))
        partial_labels.append(int(sample["partial_match"]))

    if not confidences:
        return {
            "available": False,
            "reason": "No successful records contain finite mean_token_logprob values.",
            "usable_records": 0,
        }

    return {
        "available": True,
        "usable_records": len(confidences),
        "excluded_records": len(rows) - len(confidences),
        "confidence_definition": "exp(mean_token_logprob) over generated output tokens",
        "mean_token_logprob": _mean(mean_logprobs),
        "token_perplexity": math.exp(-_mean(mean_logprobs)),
        "exact_match": _uq_for_target(confidences, exact_labels, bins),
        "partial_match": _uq_for_target(confidences, partial_labels, bins),
        "conformal_prediction": {
            "available": False,
            "reason": (
                "LAC/APS require a normalized probability distribution over all candidate "
                "cells; token_logprobs only describe generated tokens."
            ),
        },
        "limitation": (
            "Generated-token confidence includes JSON syntax and any rationale. It is a "
            "sequence-confidence proxy, not a calibrated probability that a cell is correct."
        ),
    }


def _rounded(value: Any) -> Any:
    if isinstance(value, float):
        return round(value, 6)
    if isinstance(value, dict):
        return {key: _rounded(item) for key, item in value.items()}
    if isinstance(value, list):
        return [_rounded(item) for item in value]
    return value


def _format_metrics(metrics: Dict[str, Any]) -> str:
    cell = metrics["cell_level"]
    row = metrics["row_level"]
    column = metrics["column_level"]
    return "\n".join(
        [
            "=" * 60,
            f"EVALUATION RESULTS ({metrics['total_samples']} samples)",
            "=" * 60,
            f"Cell macro P/R/F1:   {cell['precision']:.4f} / {cell['recall']:.4f} / {cell['f1']:.4f}",
            f"Cell micro P/R/F1:   {cell['micro_precision']:.4f} / {cell['micro_recall']:.4f} / {cell['micro_f1']:.4f}",
            f"Row macro P/R/F1:    {row['precision']:.4f} / {row['recall']:.4f} / {row['f1']:.4f}",
            f"Column macro P/R/F1: {column['precision']:.4f} / {column['recall']:.4f} / {column['f1']:.4f}",
            f"Exact match:          {metrics['exact_match_rate']:.4f} ({metrics['exact_match_count']}/{metrics['total_samples']})",
            f"Partial match:        {metrics['partial_match_rate']:.4f} ({metrics['partial_match_count']}/{metrics['total_samples']})",
            "=" * 60,
        ]
    )


def evaluate_file(path: Path, output_dir: Path, ece_bins: int = 10) -> Path:
    rows, raw_records, duplicate_records = _load_rows(path)
    samples = [_evaluate_sample(row) for row in rows]
    metrics = _aggregate(samples)
    uq = _evaluate_uq(rows, samples, ece_bins)
    errored = sum(bool(row.get("error")) for row in rows)
    structured = sum(bool(row.get("parsed_structured")) for row in rows)
    latencies = [
        value
        for row in rows
        if (value := _finite_float(row.get("inference_time_ms"))) is not None
    ]

    summary = _rounded(
        {
            "input_path": str(path),
            "raw_records": raw_records,
            "total_records": len(rows),
            "duplicate_records_discarded": duplicate_records,
            "errored_records": errored,
            "structured_parse_rate": structured / len(rows) if rows else 0.0,
            "avg_inference_time_ms": _mean(latencies),
            "metrics": metrics,
            "uncertainty_quantification": uq,
        }
    )

    output_dir.mkdir(parents=True, exist_ok=True)
    summary_path = output_dir / f"{path.stem}_summary.json"
    summary_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")

    print(_format_metrics(metrics))
    print(f"Raw records: {raw_records}")
    print(f"Duplicate records discarded: {duplicate_records}")
    print(f"Errored records: {errored}/{len(rows)}")
    if uq["available"]:
        exact_uq = uq["exact_match"]
        selective = exact_uq["selective_prediction"]
        print(
            "UQ exact-match Brier/ECE/AUROC/AUARC/AURC: "
            f"{exact_uq['brier_score']:.4f} / {exact_uq['ece']:.4f} / "
            f"{exact_uq['auroc'] if exact_uq['auroc'] is not None else 'N/A'} / "
            f"{selective['auarc']:.4f} / {selective['aurc']:.4f}"
        )
        print(f"UQ usable records: {uq['usable_records']}/{len(rows)}")
    else:
        print(f"UQ unavailable: {uq['reason']}")
    print(f"Saved summary: {summary_path}")
    return summary_path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Evaluate vLLM VisualCite prediction logs")
    parser.add_argument("prediction_jsonl", help="JSONL file produced by vllm_inference.py")
    parser.add_argument("--output-dir", default="vllm_results/eval")
    parser.add_argument("--ece-bins", type=int, default=10)
    args = parser.parse_args()
    if args.ece_bins < 1:
        parser.error("--ece-bins must be at least 1")
    return args


def main() -> None:
    args = parse_args()
    evaluate_file(Path(args.prediction_jsonl), Path(args.output_dir), args.ece_bins)


if __name__ == "__main__":
    main()
